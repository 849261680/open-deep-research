# 后端服务端口配置
PORT=8003

# 前端URL配置
FRONTEND_URL=http://localhost:3003

# Google OAuth 登录配置
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8003/api/auth/google/callback

# API配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith 可观测性（未配置 API key 时保持关闭，不影响本地运行）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=open-deepresearch
# 兼容旧版 LangChain 环境变量命名
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=open-deepresearch

# 环境标识
ENVIRONMENT=development

# 调试模式
DEBUG=True
